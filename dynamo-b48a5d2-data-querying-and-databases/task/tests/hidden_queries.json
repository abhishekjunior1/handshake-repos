    "order_lines": {
      "columns": ["line_id", "order_id", "product", "quantity", "unit_price"],
      "rows": [
        [1, 101, "Widget A", 2, 50.00],
        [2, 101, "Widget B", 1, 50.00],
        [3, 102, "Widget A", 3, 83.33],
        [4, 103, "Widget C", 2, 87.50],
