        [6, "Zeta Partners", "South"]
      ]
    }
  },
  "queries": [
    {
      "id": "product_summary",
      "type": "join_aggregate",
      "join": {
        "left_table": "orders",
        "right_table": "order_lines",
        "type": "inner",
        "left_on": "order_id",
        "right_on": "order_id",
        "left_prefix": "l_",
        "right_prefix": "r_"
      },
      "group_by": ["l_customer_id"],
      "aggregations": [
        {"function": "COUNT", "column": "*", "alias": "order_count"},
        {"function": "SUM", "column": "l_amount", "alias": "total_revenue"}
      ]
    },
    {
      "id": "customer_running_total",
      "type": "window",
      "source_table": "orders",
      "window": {
        "function": "RUNNING_TOTAL",
        "partition_by": "customer_id",
        "order_by": "order_date",
        "value_column": "amount",
        "alias": "cumulative_amount"
      }
    },
    {
      "id": "customer_order_count",
      "type": "join_aggregate",
      "join": {
        "left_table": "customers",
        "right_table": "orders",
        "type": "left",
        "left_on": "customer_id",
        "right_on": "customer_id",
        "left_prefix": "l_",
        "right_prefix": "r_"
      },
      "filter": {"column": "r_status", "op": "=", "value": "completed"},
      "group_by": ["l_customer_name"],
      "aggregations": [
        {"function": "COUNT", "column": "r_order_id", "alias": "completed_orders"}
      ]
    }
  ]
}
