      ]
    },
    "customers": {
      "columns": ["customer_id", "customer_name", "region"],
      "rows": [
        [1, "Alpha Corp", "North"],
        [2, "Beta Industries", "South"],
        [3, "Gamma LLC", "East"],
        [4, "Delta Holdings", "West"],
