{
  "metadata": {
    "name": "integration-pipeline",
    "version": "2.0.0",
    "description": "Multi-stage integration pipeline with parallel builds"
  },
  "settings": {
    "parallelism": 3,
    "retry_policy": "preserve_state"
  },
  "tasks": {
    "init": {
      "description": "Initialize workspace directories",
      "commands": [
        "mkdir -p /app/workspace/out",
        "mkdir -p /app/workspace/cache",
        "mkdir -p /app/workspace/dist"
      ],
      "dependencies": [],
      "priority": 5,
      "retries": 0,
      "env": {},
      "workdir": "/app",
      "conditions": {}
    },
    "fetch-config": {
      "description": "Fetch configuration files from registry",
      "commands": [
        "echo 'app_version=3.2.1' > /app/workspace/cache/config.env",
        "echo 'ready' > /app/workspace/cache/.fetched"
      ],
      "dependencies": ["init"],
      "priority": 8,
      "retries": 0,
      "env": {},
      "workdir": "/app/workspace",
      "conditions": {}
    },
    "fetch-schemas": {
      "description": "Fetch schema definitions from registry",
      "commands": [
        "mkdir -p /app/workspace/schemas",
        "echo '{\"type\": \"record\", \"version\": 2}' > /app/workspace/schemas/main.json"
      ],
      "dependencies": ["init"],
      "priority": 12,
      "retries": 0,
      "env": {},
      "workdir": "/app/workspace",
      "conditions": {}
    },
    "validate": {
      "description": "Validate configuration",
      "commands": [
        "cat /app/workspace/cache/config.env",
        "echo 'validation_passed' > /app/workspace/out/validated.txt"
      ],
      "dependencies": ["fetch-config"],
      "priority": 10,
      "retries": 0,
      "env": {},
      "workdir": "/app/workspace",
      "conditions": {
        "pre": [
          {"type": "file_exists", "path": "cache/config.env"}
        ]
      }
    },
    "setup-env": {
      "description": "Set up build environment variables and deployment configuration",
      "commands": [
        "echo 'export ARTIFACT_TAG=release-3.2.1'",
        "test -f /app/workspace/cache/.attempt || (touch /app/workspace/cache/.attempt && exit 1)",
        "echo \"${DEPLOY_TEMPLATE}\" > /app/workspace/cache/build_vars.sh",
        "echo 'configured' > /app/workspace/cache/.configured"
      ],
      "dependencies": ["validate"],
      "priority": 15,
      "retries": 2,
      "env": {
        "STAGE": "setup",
        "CACHE_DIR": "/app/workspace/cache",
        "VERSION": "3.2.1",
        "DEPLOY_TEMPLATE": "artifact=$VERSION tag=$ARTIFACT_TAG"
      },
      "workdir": "/app/workspace",
      "conditions": {
        "pre": [
          {"type": "file_exists", "path": "out/validated.txt"}
        ]
      }
    },
    "build-api": {
      "description": "Build API service component",
      "commands": [
        "mkdir -p ${BUILD_DIR}",
        "sleep 0.3",
        "echo 'api-service built' > ${BUILD_DIR}/api.out"
      ],
      "dependencies": ["setup-env"],
      "priority": 10,
      "retries": 0,
      "env": {
        "BUILD_DIR": "/app/workspace/dist/api"
      },
      "workdir": "/app/workspace",
      "conditions": {
        "pre": [
          {"type": "file_exists", "path": "cache/.configured"}
        ]
      }
    },
    "build-worker": {
      "description": "Build worker service component",
      "commands": [
        "mkdir -p ${BUILD_DIR}",
        "sleep 0.05",
        "echo 'worker-service built' > ${BUILD_DIR}/worker.out"
      ],
      "dependencies": ["setup-env"],
      "priority": 5,
      "retries": 0,
      "env": {
        "BUILD_DIR": "/app/workspace/dist/worker"
      },
      "workdir": "/app/workspace",
      "conditions": {
        "pre": [
          {"type": "file_exists", "path": "cache/.configured"}
        ]
      }
    },
    "build-gateway": {
      "description": "Build gateway service component",
      "commands": [
        "mkdir -p ${BUILD_DIR}",
        "sleep 0.15",
        "echo 'gateway-service built' > ${BUILD_DIR}/gateway.out"
      ],
      "dependencies": ["setup-env"],
      "priority": 8,
      "retries": 0,
      "env": {
        "BUILD_DIR": "/app/workspace/dist/gateway"
      },
      "workdir": "/app/workspace",
      "conditions": {
        "pre": [
          {"type": "file_exists", "path": "cache/.configured"}
        ]
      }
    },
    "package": {
      "description": "Package all built components into release bundle",
      "commands": [
        "cat /app/workspace/dist/api/api.out > /app/workspace/out/manifest.txt",
        "cat /app/workspace/dist/worker/worker.out >> /app/workspace/out/manifest.txt",
        "cat /app/workspace/dist/gateway/gateway.out >> /app/workspace/out/manifest.txt",
        "cat /app/workspace/schemas/main.json >> /app/workspace/out/manifest.txt",
        "tar czf /app/workspace/out/release.tar.gz -C /app/workspace/dist ."
      ],
      "dependencies": ["build-api", "build-worker", "build-gateway", "fetch-schemas"],
      "priority": 20,
      "retries": 0,
      "env": {},
      "workdir": "/app/workspace",
      "conditions": {
        "pre": [
          {"type": "file_exists", "path": "dist/api/api.out"},
          {"type": "file_exists", "path": "dist/worker/worker.out"},
          {"type": "file_exists", "path": "dist/gateway/gateway.out"},
          {"type": "file_exists", "path": "schemas/main.json"}
        ],
        "post": [
          {"type": "file_exists", "path": "out/release.tar.gz"}
        ]
      }
    }
  }
}
