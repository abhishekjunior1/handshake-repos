{
  "tables": {
    "orders": {
      "columns": ["order_id", "customer_id", "order_date", "freight", "status"],
      "rows": [
        [1001, 1, "2024-01-15", 25.00, "shipped"],
        [1002, 2, "2024-01-16", 18.50, "shipped"],
        [1003, 3, "2024-01-17", 32.00, "shipped"],
        [1004, 1, "2024-01-18", 15.00, "shipped"],
        [1005, 2, "2024-01-19", 22.00, "shipped"],
        [1006, 3, "2024-01-20", 28.50, "shipped"],
        [1007, 1, "2024-01-21", 19.00, "shipped"],
        [1008, 2, "2024-01-22", 35.00, "shipped"]
      ]
    },
    "order_lines": {
      "columns": ["line_id", "order_id", "product", "quantity", "unit_price"],
      "rows": [
        [1, 1001, "Widget A", 2, 10.00],
        [2, 1002, "Widget B", 1, 25.00],
        [3, 1003, "Gadget X", 3, 15.00],
        [4, 1004, "Widget A", 1, 10.00],
        [5, 1005, "Gadget Y", 2, 20.00],
        [6, 1006, "Widget B", 4, 25.00],
        [7, 1007, "Gadget X", 1, 15.00],
        [8, 1008, "Widget A", 2, 10.00]
      ]
    },
    "customers": {
      "columns": ["customer_id", "name", "region", "tier"],
      "rows": [
        [1, "Acme Corp", "North", "Gold"],
        [2, "Beta LLC", "South", "Silver"],
        [3, "Gamma Inc", "North", "Gold"]
      ]
    }
  },
  "queries": [
    {
      "type": "join_aggregate",
      "source_table": "orders",
      "select": ["l_customer_id", "order_count", "total_freight"],
      "join": {
        "table": "order_lines",
        "type": "inner",
        "on": [{"left": "order_id", "right": "order_id"}]
      },
      "group_by": ["l_customer_id"],
      "aggregations": [
        {"function": "COUNT", "column": "l_order_id", "alias": "order_count"},
        {"function": "SUM", "column": "l_freight", "alias": "total_freight"}
      ],
      "order_by": [{"column": "l_customer_id", "direction": "asc"}]
    },
    {
      "type": "window",
      "source_table": "orders",
      "select": ["*"],
      "window_functions": [
        {
          "function": "RUNNING_TOTAL",
          "partition_by": ["customer_id"],
          "order_by": [{"column": "order_date", "direction": "asc"}],
          "column": "freight",
          "alias": "cumulative_freight"
        }
      ],
      "order_by": [{"column": "customer_id", "direction": "asc"}, {"column": "order_date", "direction": "asc"}]
    },
    {
      "type": "join_aggregate",
      "source_table": "customers",
      "select": ["l_customer_id", "l_name", "l_region", "order_count", "total_value"],
      "join": {
        "table": "orders",
        "type": "left",
        "on": [{"left": "customer_id", "right": "customer_id"}],
        "filter": {"column": "r_status", "op": "=", "value": "shipped"}
      },
      "group_by": ["l_customer_id", "l_name", "l_region"],
      "aggregations": [
        {"function": "COUNT", "column": "r_order_id", "alias": "order_count"},
        {"function": "SUM", "column": "r_freight", "alias": "total_value"}
      ],
      "order_by": [{"column": "l_customer_id", "direction": "asc"}]
    }
  ]
}
