    "customers": {
      "columns": ["customer_id", "name", "region", "tier"],
      "rows": [
        [10, "Northwind Co", "East", "Gold"],
        [20, "Southgate Ltd", "West", "Silver"],
        [30, "Eastview Corp", "East", "Gold"],
