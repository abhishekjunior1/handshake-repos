  },
  "queries": [
    {
      "type": "join_aggregate",
      "source_table": "orders",
      "select": ["l_customer_id", "order_count", "total_freight"],
      "join": {
        "table": "order_lines",
        "type": "inner",
        "on": [{"left": "order_id", "right": "order_id"}]
      },
      "group_by": ["l_customer_id"],
      "aggregations": [
        {"function": "COUNT", "column": "l_order_id", "alias": "order_count"},
        {"function": "SUM", "column": "l_freight", "alias": "total_freight"}
      ],
      "order_by": [{"column": "l_customer_id", "direction": "asc"}]
    },
    {
      "type": "window",
      "source_table": "orders",
      "select": ["*"],
      "window_functions": [
        {
          "function": "RUNNING_TOTAL",
          "partition_by": ["customer_id"],
          "order_by": [{"column": "order_date", "direction": "asc"}],
          "column": "freight",
          "alias": "cumulative_freight"
        }
      ],
      "order_by": [{"column": "customer_id", "direction": "asc"}, {"column": "order_date", "direction": "asc"}]
    },
    {
      "type": "join_aggregate",
      "source_table": "customers",
      "select": ["l_customer_id", "l_name", "l_region", "order_count", "total_value"],
      "join": {
        "table": "orders",
        "type": "left",
        "on": [{"left": "customer_id", "right": "customer_id"}],
        "filter": {"column": "r_status", "op": "=", "value": "shipped"}
      },
      "group_by": ["l_customer_id", "l_name", "l_region"],
      "aggregations": [
        {"function": "COUNT", "column": "r_order_id", "alias": "order_count"},
        {"function": "SUM", "column": "r_freight", "alias": "total_value"}
      ],
      "order_by": [{"column": "l_customer_id", "direction": "asc"}]
    }
  ]
}
