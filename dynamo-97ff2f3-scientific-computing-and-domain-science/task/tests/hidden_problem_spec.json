{
  "system": {
    "name": "Orbital Mechanics Two-Body Problem",
    "equations": [
      "y[2]",
      "y[3]",
      "-398600.0 * y[0] / (sqrt(y[0]*y[0] + y[1]*y[1]))**3",
      "-398600.0 * y[1] / (sqrt(y[0]*y[0] + y[1]*y[1]))**3"
    ],
    "initial_conditions": [6778.0, 0.0, 0.0, 7.669],
    "t_start": 0.0,
    "t_end": 5400.0,
    "parameters": {},
    "variable_names": ["x_pos", "y_pos", "x_vel", "y_vel"]
  },
  "solver_config": {
    "atol": 1e-6,
    "rtol": 1e-3,
    "max_step": 100.0,
    "min_step": 1e-10,
    "initial_step": 1.0,
    "output_points": 30,
    "max_steps": 50000,
    "stiffness_threshold": 6.0,
    "stiffness_window": 5
  }
}
