{
  "tables": {
    "orders": {
      "columns": ["order_id", "customer_id", "order_date", "amount", "status"],
      "rows": [
        [1, 1, "2024-01-15", 120.00, "completed"],
        [2, 1, "2024-01-16", 85.50, "completed"],
        [3, 2, "2024-01-17", 200.00, "completed"],
        [4, 2, "2024-01-18", 45.00, "completed"],
        [5, 3, "2024-01-19", 310.00, "completed"],
        [6, 1, "2024-01-20", 67.25, "completed"],
        [7, 3, "2024-01-21", 150.00, "completed"],
        [8, 2, "2024-01-22", 92.00, "completed"]
      ]
    },
    "order_lines": {
      "columns": ["line_id", "order_id", "product", "quantity", "unit_price"],
      "rows": [
        [1, 1, "Widget A", 2, 60.00],
        [2, 2, "Widget B", 3, 28.50],
        [3, 3, "Widget A", 4, 50.00],
        [4, 4, "Widget C", 1, 45.00],
        [5, 5, "Widget B", 5, 62.00],
        [6, 6, "Widget A", 1, 67.25],
        [7, 7, "Widget C", 3, 50.00],
        [8, 8, "Widget B", 2, 46.00]
      ]
    },
    "customers": {
      "columns": ["customer_id", "customer_name", "region"],
      "rows": [
        [1, "Alice Corp", "North"],
        [2, "Bob Industries", "South"],
        [3, "Charlie LLC", "East"]
      ]
    }
  },
  "queries": [
    {
      "id": "product_summary",
      "type": "join_aggregate",
      "join": {
        "left_table": "orders",
        "right_table": "order_lines",
        "type": "inner",
        "left_on": "order_id",
        "right_on": "order_id",
        "left_prefix": "l_",
        "right_prefix": "r_"
      },
      "group_by": ["l_customer_id"],
      "aggregations": [
        {"function": "COUNT", "column": "*", "alias": "order_count"},
        {"function": "SUM", "column": "l_amount", "alias": "total_revenue"}
      ]
    },
    {
      "id": "customer_running_total",
      "type": "window",
      "source_table": "orders",
      "window": {
        "function": "RUNNING_TOTAL",
        "partition_by": "customer_id",
        "order_by": "order_date",
        "value_column": "amount",
        "alias": "cumulative_amount"
      }
    },
    {
      "id": "customer_order_count",
      "type": "join_aggregate",
      "join": {
        "left_table": "customers",
        "right_table": "orders",
        "type": "left",
        "left_on": "customer_id",
        "right_on": "customer_id",
        "left_prefix": "l_",
        "right_prefix": "r_"
      },
      "filter": {"column": "r_status", "op": "=", "value": "completed"},
      "group_by": ["l_customer_name"],
      "aggregations": [
        {"function": "COUNT", "column": "r_order_id", "alias": "completed_orders"}
      ]
    }
  ]
}
