{
  "system": {
    "name": "Damped Harmonic Oscillator",
    "equations": [
      "y[1]",
      "-2.0 * 0.1 * 1.0 * y[1] - 1.0 * 1.0 * y[0]"
    ],
    "initial_conditions": [1.0, 0.0],
    "t_start": 0.0,
    "t_end": 10.0,
    "parameters": {},
    "variable_names": ["displacement", "velocity"]
  },
  "solver_config": {
    "atol": 1e-3,
    "rtol": 1e-6,
    "max_step": 1.0,
    "min_step": 1e-12,
    "initial_step": 0.1,
    "output_points": 20,
    "max_steps": 10000,
    "stiffness_threshold": 6.0,
    "stiffness_window": 5
  }
}
